# Файлы, которые не нужно загружать на хостинг (Railway) и в git.

# Кэш Python (создаётся автоматически)
__pycache__/
*.pyc

# Папка данных (базы, скриншоты, профиль браузера). На хостинге её заменяет Volume.
data/

# Локальные базы данных (если лежат вне папки data/)
*.db
*.db-journal
*.db-wal
*.db-shm

# Картинки-скриншоты и профиль браузера автопилота
worker/screenshots/
worker/.browser-profile/

# Секреты (токены, ключи)
.env

# Виртуальное окружение
.venv/
venv/
