# ─────────────────────────────────────────────────────────────────────────────
# .env.example — образец настроек «Джонатана Ливингстона».
#
# Как пользоваться: скопируй этот файл в файл с именем `.env` (без "example"),
# впиши свои значения и запусти программу. ИЛИ — на хостинге Railway — просто
# добавь эти же переменные в разделе Variables в настройках сервиса (без файла).
#
# Ничего из этого НЕ обязательно: без переменных программа работает в
# "гостевом" режиме (можно открыть сайт в браузере без Telegram).
# ─────────────────────────────────────────────────────────────────────────────

# --- Порт и адрес (обычно НЕ нужно менять) -----------------------------------
# На Railway порт задаётся автоматически переменной PORT — её не трогай.
PORT=8085
HOST=0.0.0.0

# --- Папка данных (базы, скриншоты, профиль браузера) ------------------------
# По умолчанию данные лежат в папке data/ рядом с кодом. На Railway укажи /data
# (туда подключается постоянный диск Volume — тогда данные не стираются).
DATA_DIR=

# --- Токены Telegram-ботов (нужны, чтобы работал сам бот и вход в Mini App) ---
# Токен выдаёт @BotFather в Telegram при создании бота.
PERSONAL_BOT_TOKEN=
SAAS_BOT_TOKEN=
# Имя бота для кнопок-ссылок (без @):
BOT_USERNAME=

# --- Сайт (Mini App) ----------------------------------------------------------
# На Railway укажи свой адрес вида https://job-hunter.up.railway.app
WEBAPP_URL=

# --- Вход на сайт -------------------------------------------------------------
# 0 (или пусто) = строгий вход: сайт открывается только внутри Telegram (через бота).
# 1 = гостевой режим: сайт можно открыть по ссылке в любом браузере, а внутри
#     Telegram пользователь всё равно распознаётся. Для демо ставь 1.
MINIAPP_DEV_FALLBACK=1

# --- Ключи ИИ (опционально: без них работает бесплатный встроенный генератор) --
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Bluesky (опционально: живой поиск вакансий в Bluesky) -------------------
# BSKY_HANDLE=твой.bsky.social
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Оплата Stripe (для тарифов Варианта Б) ----------------------------------
# Без STRIPE_SECRET_KEY тарифы активируются в демо-режиме (без денег).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Валюта и готовые цены (если не задать цены — сумма берётся из прайса в рублях):
# STRIPE_CURRENCY=usd
# STRIPE_PRICE_FAST=price_XXXX
# STRIPE_PRICE_STRONG=price_XXXX
# STRIPE_PRICE_MAX=price_XXXX
# Куда вести пользователя после оплаты/отмены (по умолчанию — сам сайт):
# STRIPE_SUCCESS_URL=https://job-hunter.up.railway.app/app?mode=saas&pay=success
# STRIPE_CANCEL_URL=https://job-hunter.up.railway.app/app?mode=saas&pay=cancel
# Webhook (укажи этот адрес в Stripe → Developers → Webhooks):
#   https://job-hunter.up.railway.app/api/saas/webhook

# --- Автопилот откликов (Playwright; на хостинге работает через Dockerfile) ---
APPLY_DRY_RUN=1
APPLY_DAILY_LIMIT=20
APPLY_MIN_DELAY=45
APPLY_MAX_DELAY=150
# 0 = показывать окно браузера (локально), 1 = в фоне (на хостинге обязательно 1)
APPLY_HEADLESS=0
# Какой браузер использовать: chrome (по умолчанию, локально) или пусто (встроенный Chromium в Docker)
# APPLY_BROWSER_CHANNEL=chrome
# APPLY_PROFILE_DIR=/data/browser-profile
APPLY_ANSWER_QUESTIONS=1
APPLY_MAX_ATTEMPTS=3
