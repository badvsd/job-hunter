# ─────────────────────────────────────────────────────────────────────────────
# .env.example — образец настроек «Джонатана Ливингстона».
#
# Как пользоваться: скопируй этот файл в файл с именем `.env` (без "example"),
# впиши свои значения и запусти программу. ИЛИ — на хостинге Railway — просто
# добавь эти же переменные в разделе Variables в настройках сервиса (без файла).
#
# Ничего из этого НЕ обязательно: без переменных программа работает в
# "гостевом" режиме (можно открыть сайт в браузере без Telegram).
# ─────────────────────────────────────────────────────────────────────────────

# --- Порт и адрес (обычно НЕ нужно менять) -----------------------------------
# На Railway порт задаётся автоматически переменной PORT — её не трогай.
PORT=8085
HOST=0.0.0.0

# --- Токены Telegram-ботов (нужны, чтобы работал сам бот и вход в Mini App) ---
# Токен выдаёт @BotFather в Telegram при создании бота.
PERSONAL_BOT_TOKEN=
SAAS_BOT_TOKEN=
# Имя бота для кнопок-ссылок (без @):
BOT_USERNAME=

# --- Сайт (Mini App) ----------------------------------------------------------
# На Railway укажи свой адрес вида https://твой-сервис.up.railway.app
WEBAPP_URL=

# --- Ключи ИИ (опционально: без них работает бесплатный встроенный генератор) --
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Bluesky (опционально: живой поиск вакансий в Bluesky) -------------------
# BSKY_HANDLE=твой.bsky.social
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Оплата Stripe (для тарифов Варианта Б) ----------------------------------
# Без STRIPE_SECRET_KEY тарифы активируются в демо-режиме (без денег).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Валюта и готовые цены (если не задать цены — сумма берётся из прайса в рублях):
# STRIPE_CURRENCY=usd
# STRIPE_PRICE_FAST=price_XXXX
# STRIPE_PRICE_STRONG=price_XXXX
# STRIPE_PRICE_MAX=price_XXXX
# Куда вести пользователя после оплаты/отмены (по умолчанию — сам сайт):
# STRIPE_SUCCESS_URL=https://твой-сайт/app?mode=saas&pay=success
# STRIPE_CANCEL_URL=https://твой-сайт/app?mode=saas&pay=cancel

# --- Автопилот откликов (Playwright, работает локально, см. README) ----------
APPLY_DRY_RUN=1
APPLY_DAILY_LIMIT=20
APPLY_MIN_DELAY=45
APPLY_MAX_DELAY=150
APPLY_HEADLESS=0
APPLY_ANSWER_QUESTIONS=1
APPLY_MAX_ATTEMPTS=3
